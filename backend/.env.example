# ── REQUIRED ──────────────────────────────────────────────────────────────────
# Generate a strong random key:  python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=SomaHub Enterprise
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/somahub

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://localhost:8000"]

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Auth ──────────────────────────────────────────────────────────────────────
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
EMAIL_VERIFY_TOKEN_EXPIRE_HOURS=24
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60

# ── Object Storage ────────────────────────────────────────────────────────────
STORAGE_PROVIDER=local
# Supabase (optional)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET_EBOOKS=ebooks
SUPABASE_BUCKET_COVERS=covers
SUPABASE_BUCKET_AVATARS=avatars
SUPABASE_BUCKET_OCR=ocr-uploads
# S3-compatible (optional, e.g. Cloudflare R2, MinIO, AWS S3)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_BUCKET_EBOOKS=somahub-ebooks
S3_BUCKET_COVERS=somahub-covers
S3_BUCKET_AVATARS=somahub-avatars

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@somahub.io
EMAIL_FROM_NAME=SomaHub

# ── Payments ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ── Search ────────────────────────────────────────────────────────────────────
SEARCH_PROVIDER=basic
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=

# ── AI / Ollama ────────────────────────────────────────────────────────────────
# Local LLM backend URL (only AI_OLLAMA_HOST is actually used in code)
AI_OLLAMA_HOST=http://localhost:11434
# Chat model (default: llama3:latest if not set)
AI_CHAT_MODEL=llama3:latest
# Embedding model (default: nomic-embed-text)
AI_EMBEDDING_MODEL=nomic-embed-text
# Vision model for OCR (default: granite-vision:latest)
AI_VISION_MODEL=granite-vision:latest

# ── AI Module Configuration (optional overrides) ──────────────────────────────
# AI_OLLAMA_TIMEOUT=120
# AI_CHAT_TEMPERATURE=0.7
# AI_CHAT_MAX_TOKENS=2048
# AI_CHAT_TOP_P=0.9
# AI_EMBEDDING_DIMENSIONS=768
# AI_VISION_TEMPERATURE=0.2
# AI_VISION_MAX_TOKENS=4096
# AI_CHUNK_SIZE=512
# AI_CHUNK_OVERLAP=64
# AI_RETRIEVAL_TOP_K=5
# AI_RETRIEVAL_SCORE_THRESHOLD=0.65
# AI_VECTOR_STORE_TYPE=chromadb
# AI_VECTOR_STORE_PATH=data/vectordb
# AI_VECTOR_STORE_COLLECTION=somahub_knowledge
# AI_INGESTION_MAX_FILE_SIZE_MB=50
# AI_OCR_ENABLED=true
# AI_APP_KNOWLEDGE_ENABLED=true
# AI_MAX_HISTORY_LENGTH=20
