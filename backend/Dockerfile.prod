FROM python:3.12-slim

WORKDIR /app

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    APP_ENV=production \
    DEBUG=false

RUN pip install uv

# Copy configuration files and sync dependencies
# Using --no-dev ensures testing and dev tools aren't shipped to production
COPY pyproject.toml uv.lock ./
RUN uv sync --no-dev

# Copy the rest of the application
COPY . .

EXPOSE 8000

# Run Uvicorn without hot-reloading. In a heavier production setup, 
# you might use gunicorn with uvicorn workers for concurrency.
CMD ["uv", "run", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
