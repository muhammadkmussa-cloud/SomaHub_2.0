# --- Database (PostgreSQL) ---
POSTGRES_USER=somahub_user
POSTGRES_PASSWORD=secure_postgres_password_here
POSTGRES_DB=somahub

# --- Redis ---
REDIS_PASSWORD=secure_redis_password_here

# --- Backend App Config ---
# Notice how the backend points to the docker service names 'postgres' and 'redis'
DATABASE_URL=postgresql+asyncpg://somahub_user:secure_postgres_password_here@postgres:5432/somahub
REDIS_URL=redis://:secure_redis_password_here@redis:6379/0

APP_ENV=production
DEBUG=false
SECRET_KEY=your_super_secret_key_here

# --- Frontend Config ---
# This is the public URL the user's browser uses to contact the backend.
# In a real deployment, this would be your domain, e.g., https://api.yourdomain.com/api/v1
PUBLIC_API_URL=http://localhost:8000/api/v1
\n# Security\nCORS_ORIGINS=["http://localhost:5173", "https://yourdomain.com", "https://www.yourdomain.com"]
